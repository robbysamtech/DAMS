        <mxCell id="events-fields" value="_id: ObjectId (PK)&#xa;title: String (required, max:200)&#xa;description: String (required)&#xa;date: Date (required)&#xa;time: String (required)&#xa;address.streetAddress: String (required, max:200)&#xa;address.city: String (required, max:100)&#xa;address.state: String (required, max:50)&#xa;address.zipCode: String (required, max:20)&#xa;creator: ObjectId (FK → users._id)&#xa;status: String (enum: draft, published, cancelled, completed)&#xa;category: String (max:200)&#xa;eventType: String (enum: in-person, virtual, hybrid)&#xa;maxAttendees: Number (min:1)&#xa;registrationRequired: Boolean&#xa;eventImage: String&#xa;tags: [String] (max:100 each)&#xa;metadata.viewCount: Number&#xa;metadata.attendeeCount: Number&#xa;metadata.registrationCount: Number&#xa;metadata.lastUpdated: Date&#xa;visibility: String (enum: public, private, restricted)&#xa;recurring.isRecurring: Boolean&#xa;recurring.frequency: String (enum: daily, weekly, monthly, yearly)&#xa;recurring.endDate: Date&#xa;recurring.daysOfWeek: [Number] (0-6)&#xa;createdAt: Date&#xa;updatedAt: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="events">
